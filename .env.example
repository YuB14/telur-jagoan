# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Authentication
SESSION_SECRET="replace-with-a-long-random-secret"

# Initial development accounts (required by `npm run prisma:seed`)
SEED_OWNER_PASSWORD="CHANGE_ME_MIN_8_CHARS"
SEED_CASHIER_PASSWORD="CHANGE_ME_MIN_8_CHARS"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Product image storage (`local` for development, `s3` for production)
STORAGE_DRIVER="local"
STORAGE_BUCKET_URL=""
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_BUCKET_NAME=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
